---
import type { Flat } from "@/types"

interface Props {
	flat?: Partial<Flat>
	errors?: Record<string, string>
	action?: string
	isEditing?: boolean
}

const { flat = {}, errors = {}, action = "", isEditing = false } = Astro.props as Props

const input =
	"mt-1 block w-full rounded-md border border-gray-300 shadow-sm py-2 px-3 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
---

<form action={action} method="POST" class="space-y-6 p-6">
	<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
		<div class="space-y-1">
			<label for="flat_id" class="block text-sm font-medium text-gray-700">ID*</label>
			<input
				type="text"
				id="flat_id"
				name="flat_id"
				value={flat.flat_id || ""}
				placeholder="FFCC71"
				pattern="[A-Za-z0-9]+"
				title="Solo letras y números, por ejemplo FFCC71"
				readonly={isEditing}
				required
				class={`${input} ${isEditing ? "bg-gray-100 text-gray-500" : ""}`}
			/>
			<p class="text-xs text-gray-500">
				{
					isEditing
						? "El ID no se puede cambiar: lo usan las habitaciones, sus fotos y las carpetas de Storage."
						: "Solo letras y números, p. ej. FFCC71. Será el prefijo de los IDs de sus habitaciones."
				}
			</p>
			{errors.flat_id && <p class="text-sm text-red-600">{errors.flat_id}</p>}
		</div>

		<div class="space-y-1">
			<label for="title" class="block text-sm font-medium text-gray-700">Título*</label>
			<input type="text" id="title" name="title" value={flat.title || ""} required class={input} />
			{errors.title && <p class="text-sm text-red-600">{errors.title}</p>}
		</div>

		<div class="space-y-1">
			<label for="street" class="block text-sm font-medium text-gray-700">Dirección</label>
			<input type="text" id="street" name="street" value={flat.street || ""} class={input} />
		</div>

		<div class="space-y-1">
			<label for="neighborhood" class="block text-sm font-medium text-gray-700">Barrio</label>
			<input type="text" id="neighborhood" name="neighborhood" value={flat.neighborhood || ""} class={input} />
		</div>

		<div class="space-y-1">
			<label for="city" class="block text-sm font-medium text-gray-700">Ciudad</label>
			<input type="text" id="city" name="city" value={flat.city ?? "Barcelona"} class={input} />
		</div>

		<div class="space-y-1">
			<label for="postalCode" class="block text-sm font-medium text-gray-700">Código postal</label>
			<input type="text" id="postalCode" name="postalCode" value={flat.postalCode || ""} inputmode="numeric" class={input} />
		</div>
	</div>

	<div class="space-y-1">
		<label for="mapImage" class="block text-sm font-medium text-gray-700">URL del mapa (Google Maps embed)</label>
		<textarea id="mapImage" name="mapImage" rows="3" class={input}>{flat.mapImage || ""}</textarea>
		<p class="text-xs text-gray-500">
			En Google Maps: Compartir → Insertar un mapa → copia solo la dirección del atributo <code>src</code>.
		</p>
		{errors.mapImage && <p class="text-sm text-red-600">{errors.mapImage}</p>}
	</div>

	<div class="flex items-center space-x-2">
		<input
			type="checkbox"
			id="available"
			name="available"
			checked={flat.available ?? true}
			class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
		/>
		<label for="available" class="text-sm text-gray-700">Piso activo (visible en la web)</label>
	</div>

	{errors.general && <p class="rounded-md bg-red-50 p-3 text-sm text-red-800">{errors.general}</p>}

	<div class="flex justify-end space-x-4 border-t border-gray-200 pt-6">
		<a
			href="/admin/flats"
			class="inline-flex justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"
		>
			Cancelar
		</a>
		<button
			type="submit"
			class="inline-flex justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700"
		>
			{isEditing ? "Guardar cambios" : "Crear piso"}
		</button>
	</div>
</form>
