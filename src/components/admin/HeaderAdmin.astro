---
import ReadOnlyBadge from "@/components/admin/ReadOnlyBadge.astro"
import NotificationsBell from "@/components/admin/NotificationsBell.astro"

const { user } = Astro.locals
const isLoggedIn = !!user
// En el propio dashboard no hace falta el botón para ir a él
const showDashboardLink = isLoggedIn && Astro.url.pathname !== "/admin/dashboard"
---

<style>
	.mobile-menu {
		position: absolute;
		top: 100%;
		right: 0;
		background: var(--headerBg, white);
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
		width: 100%;
		display: flex;
		flex-direction: column;
		padding: 1rem;
		gap: 0.5rem;
		width: 100%;
		text-align: center;
	}

	.hidden {
		display: none;
	}

	img {
		width: 7.5rem;
	}

	@media (min-width: 640px) {
		img {
			width: 15rem;
		}
	}

	@media (min-width: 768px) {
		.desktop-menu {
			display: flex;
		}

		.mobile-menu {
			display: none; /* Siempre oculta el menú móvil en pantallas grandes */
		}
	}
</style>

<header
	class="sticky top-0 z-50 flex w-full items-center justify-between bg-headerBg px-4 py-3 backdrop-blur-xl sm:px-9 sm:py-4"
>
	<div class="flex w-full items-center justify-between md:mx-auto md:max-w-[1400px]">
		<!-- Logo -->
		<a href="/">
			<img src="/logo.svg" alt="Logo RentRoomBcn" />
		</a>

		<div class="flex items-center gap-1.5 sm:gap-4">
		<ReadOnlyBadge />
		{isLoggedIn && <NotificationsBell />}
		{
			showDashboardLink && (
				<a href="/admin/dashboard" class="inline-flex items-center rounded-md border border-[#4B6A40] bg-[#587A4B] px-2 py-1.5 text-xs font-semibold sm:px-4 sm:py-2 sm:text-sm text-white shadow-sm hover:bg-[#4B6A40] focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
					Dashboard
				</a>
			)
		}

		<!-- Cerrar sesión (solo visible si está logueado) -->
		{
			isLoggedIn && (
				<form method="POST" action="/api/auth/logout">
					<button
						id="menu-button"
						type="submit"
						aria-label="Cerrar sesión"
						title="Cerrar sesión"
						class="inline-flex items-center rounded-md border border-gray-300 bg-white px-2 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 sm:px-4 sm:py-2 sm:text-sm"
					>
						Salir
					</button>
				</form>
			)
		}
		</div>
	</div>
</header>
