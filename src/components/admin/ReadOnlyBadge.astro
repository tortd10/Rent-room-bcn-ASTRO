---
// Indicador de modo solo lectura: un ojo en un círculo amarillo. Al pulsarlo se abre un mensaje que lo explica
// (popover nativo del navegador: se cierra al pulsar fuera o con Esc, sin JavaScript).
const { class: className = "" } = Astro.props
---

{
	Astro.locals.isViewer && (
		<>
			<button
				type="button"
				popovertarget="readonly-info"
				aria-label="Solo lectura: más información"
				title="Solo lectura"
				class:list={[
					"inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-yellow-100 sm:h-9 sm:w-9 text-yellow-800 hover:bg-yellow-200 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2",
					className,
				]}
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
					<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
				</svg>
			</button>
			<div
				id="readonly-info"
				popover
				role="status"
				class="fixed inset-auto right-4 top-16 m-0 w-72 max-w-[calc(100vw-2rem)] rounded-xl border border-yellow-200 bg-white p-4 text-sm text-gray-700 shadow-xl"
			>
				<p class="font-semibold text-yellow-800">Modo solo lectura</p>
				<p class="mt-1">
					Puedes ver toda la información, pero no modificar nada. Para crear, editar o eliminar se te pedirán las credenciales de un administrador.
				</p>
			</div>
		</>
	)
}
