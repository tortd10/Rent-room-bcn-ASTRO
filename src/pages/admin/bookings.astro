---
import SectionContainer from "@/components/SectionContainer.astro"
import LayoutAdmin from "@/layouts/LayoutAdmin.astro"
import { getLeads, updateLeadStatus } from "@/db/api/leads"
import type { LeadStatus } from "@/types"

const { user, supabase } = Astro.locals
if (!user) {
	return Astro.redirect("/admin")
}

const STATUSES: Record<LeadStatus, { label: string; badge: string }> = {
	new: { label: "Nueva", badge: "bg-purple-100 text-purple-800" },
	contacted: { label: "Contactada", badge: "bg-blue-100 text-blue-800" },
	closed: { label: "Cerrada", badge: "bg-gray-100 text-gray-700" },
}

// Cambiar el estado de una consulta
if (Astro.request.method === "POST") {
	const form = await Astro.request.formData()
	const id = Number(form.get("id"))
	const status = form.get("status")?.toString() as LeadStatus
	if (Number.isInteger(id) && status in STATUSES) {
		await updateLeadStatus(supabase, id, status)
	}
	return Astro.redirect(Astro.url.pathname + Astro.url.search)
}

const filter = Astro.url.searchParams.get("status") as LeadStatus | null
const { data: leads, error } = await getLeads(supabase, filter && filter in STATUSES ? filter : undefined)

const fmt = new Intl.DateTimeFormat("es-ES", { dateStyle: "medium", timeStyle: "short" })
---

<LayoutAdmin title="RentRoomBcn - Consultas">
	<SectionContainer>
		<div class="space-y-6 p-6">
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-2xl font-bold text-gray-800">Consultas recibidas</h1>
					<p class="text-sm text-gray-500">{leads?.length ?? 0} consultas</p>
				</div>
				<a href="/admin/dashboard" class="text-sm font-medium text-gray-600 hover:underline">← Dashboard</a>
			</div>

			<nav class="flex gap-2 text-sm">
				<a href="/admin/bookings" class={`rounded-full px-3 py-1 ${!filter ? "bg-gray-800 text-white" : "bg-gray-100"}`}>Todas</a>
				{
					(Object.keys(STATUSES) as LeadStatus[]).map((s) => (
						<a
							href={`/admin/bookings?status=${s}`}
							class={`rounded-full px-3 py-1 ${filter === s ? "bg-gray-800 text-white" : "bg-gray-100"}`}
						>
							{STATUSES[s].label}
						</a>
					))
				}
			</nav>

			{error && <p class="rounded-md bg-red-50 p-4 text-sm text-red-800">Error al cargar: {error.message}</p>}

			{
				leads && leads.length === 0 && (
					<p class="rounded-lg bg-white p-6 text-center text-gray-500 shadow">No hay consultas todavía.</p>
				)
			}

			<ul class="space-y-4">
				{
					leads?.map((lead) => (
						<li class="space-y-3 rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
							<div class="flex flex-wrap items-start justify-between gap-3">
								<div>
									<p class="font-semibold text-gray-900">{lead.name}</p>
									<p class="text-sm text-gray-600">
										<a href={`mailto:${lead.email}`} class="text-indigo-600 hover:underline">{lead.email}</a>
										{lead.phone && <> · <a href={`tel:${lead.phone}`} class="hover:underline">{lead.phone}</a></>}
									</p>
									<p class="text-xs text-gray-500">
										{fmt.format(new Date(lead.created_at))} · {lead.lang.toUpperCase()}
										{lead.room_slug && <> · Habitación: <a href={`/admin/rooms/view/${lead.room_slug}`} class="hover:underline">{lead.rooms?.name ?? lead.room_slug}</a></>}
										{lead.delivery_date && <> · Entrada: {lead.delivery_date}</>}
									</p>
								</div>
								<form method="POST" class="flex items-center gap-2">
									<input type="hidden" name="id" value={lead.id} />
									<span class={`rounded-full px-2 py-0.5 text-xs font-semibold ${STATUSES[lead.status].badge}`}>
										{STATUSES[lead.status].label}
									</span>
									<select name="status" class="rounded-md border border-gray-300 px-2 py-1 text-sm" aria-label="Cambiar estado">
										{(Object.keys(STATUSES) as LeadStatus[]).map((s) => (
											<option value={s} selected={s === lead.status}>{STATUSES[s].label}</option>
										))}
									</select>
									<button type="submit" class="rounded-md bg-gray-800 px-3 py-1 text-sm text-white hover:bg-gray-700">Guardar</button>
								</form>
							</div>
							<p class="whitespace-pre-line text-sm text-gray-700">{lead.message}</p>
						</li>
					))
				}
			</ul>
		</div>
	</SectionContainer>
</LayoutAdmin>
