---
import SectionContainer from "@/components/SectionContainer.astro"
import LayoutAdmin from "@/layouts/LayoutAdmin.astro"
import { getFlatById } from "@/db/api/flats"
import { publicImageUrl } from "@/lib/images"

const { user, supabase } = Astro.locals
if (!user) return Astro.redirect("/admin")

const { id } = Astro.params
const { data: flat } = id ? await getFlatById(supabase, id) : { data: null }

const [roomsRes, mediaRes] = flat
	? await Promise.all([
			supabase
				.from("rooms")
				.select("id, slug, name, available, status, imageSrc")
				.eq("flat_id", flat.flat_id)
				.order("id"),
			supabase
				.from("room_images")
				.select("path, kind")
				.eq("flat_id", flat.flat_id)
				.is("room_id", null)
				.order("position", { ascending: true }),
		])
	: [null, null]

const rooms = roomsRes?.data ?? []
const commonImages = (mediaRes?.data ?? []).filter((m) => m.kind === "image")
const commonVideos = (mediaRes?.data ?? []).filter((m) => m.kind === "video")
const availableRooms = rooms.filter((r) => r.available).length

// Consultas recibidas por las habitaciones de este piso
const slugs = rooms.map((r) => r.slug)
const leadsRes = slugs.length
	? await supabase
			.from("leads")
			.select("id, created_at, name, email, status, room_slug")
			.in("room_slug", slugs)
			.order("created_at", { ascending: false })
			.limit(5)
	: null
const newLeads = slugs.length
	? (
			await supabase
				.from("leads")
				.select("*", { count: "exact", head: true })
				.in("room_slug", slugs)
				.eq("status", "new")
		).count ?? 0
	: 0

const STATUS_LABEL: Record<string, string> = { available: "Activa", soon: "Próximamente" }
const LEAD_STATUS: Record<string, { label: string; badge: string }> = {
	new: { label: "Nueva", badge: "bg-purple-100 text-purple-800" },
	contacted: { label: "Contactada", badge: "bg-blue-100 text-blue-800" },
	closed: { label: "Cerrada", badge: "bg-gray-100 text-gray-700" },
}
const fmt = new Intl.DateTimeFormat("es-ES", { dateStyle: "medium", timeStyle: "short" })

const missing = flat
	? [
			!flat.street && "Falta la dirección",
			!flat.neighborhood && "Falta el barrio",
			!flat.postalCode && "Falta el código postal",
			!flat.mapImage && "Falta el mapa",
			rooms.length === 0 && "El piso no tiene habitaciones",
			commonImages.length === 0 && "Sin fotos de zonas comunes",
		].filter(Boolean)
	: []
---

<LayoutAdmin title={flat?.title || "Detalle Piso"}>
	<SectionContainer>
		{
			!flat ? (
				<div class="space-y-4 p-4 sm:p-6">
					<p class="rounded-md bg-red-50 p-4 text-sm text-red-800">Piso no encontrado</p>
					<a href="/admin/flats" class="btn-secondary">← Volver al listado</a>
				</div>
			) : (
				<div class="space-y-6 p-4 sm:p-6">
					<!-- Cabecera -->
					<div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
						<div class="space-y-2">
							<h1 class="text-2xl font-bold text-gray-800">{flat.title}</h1>
							<div class="flex flex-wrap items-center gap-2 text-sm">
								<span class="rounded bg-gray-100 px-2 py-0.5 font-mono text-gray-700">{flat.flat_id}</span>
								<span class={`badge ${flat.available ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800"}`}>
									{flat.available ? "Activo" : "Inactivo"}
								</span>
								<span class="badge bg-blue-100 text-blue-800">
									{availableRooms} de {rooms.length} habitaciones disponibles
								</span>
								{newLeads > 0 && (
									<a href="/admin/bookings?status=new" class="badge bg-purple-100 text-purple-800">
										{newLeads} consulta{newLeads === 1 ? "" : "s"} nueva{newLeads === 1 ? "" : "s"}
									</a>
								)}
							</div>
						</div>
						<div class="flex flex-wrap gap-2 md:gap-3">
							<a href="/admin/flats" class="btn-secondary">← Volver al listado</a>
							<a href="/es/Flats" target="_blank" rel="noopener" class="btn-secondary">Ver en la web</a>
							<a href={`/admin/flats/edit/${flat.flat_id}`} class="btn-primary">Editar</a>
						</div>
					</div>

					{missing.length > 0 && (
						<div class="rounded-md border border-yellow-200 bg-yellow-50 p-4">
							<p class="text-sm font-medium text-yellow-800">Pendiente de completar</p>
							<ul class="mt-2 list-disc pl-5 text-sm text-yellow-800">
								{missing.map((m) => <li>{m}</li>)}
							</ul>
						</div>
					)}

					<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
						<div class="space-y-6 lg:col-span-2">
							<!-- Habitaciones -->
							<div class="card p-4 sm:p-6">
								<div class="mb-4 flex items-center justify-between">
									<h2 class="text-lg font-semibold">Habitaciones ({rooms.length})</h2>
									<a href="/admin/rooms/new" class="text-sm text-indigo-600 hover:underline">+ Nueva habitación</a>
								</div>
								{rooms.length > 0 ? (
									<ul class="divide-y divide-gray-100">
										{rooms.map((r) => (
											<li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
												<div class="flex items-center gap-3">
													{r.imageSrc ? (
														<img src={r.imageSrc} alt="" class="h-12 w-12 rounded object-cover" loading="lazy" />
													) : (
														<div class="h-12 w-12 rounded bg-gray-100"></div>
													)}
													<div>
														<a href={`/admin/rooms/view/${r.slug}`} class="font-medium text-gray-900 hover:underline">{r.name}</a>
														<p class="font-mono text-xs text-gray-500">{r.slug}</p>
													</div>
												</div>
												<div class="flex flex-wrap items-center gap-2">
													<span class={`badge ${r.available ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800"}`}>
														{r.available ? "Disponible" : "Ocupada"}
													</span>
													<span class="badge bg-blue-100 text-blue-800">{STATUS_LABEL[r.status] ?? r.status}</span>
													<a href={`/admin/rooms/edit/${r.id}`} class="text-sm text-indigo-600 hover:underline">Editar</a>
												</div>
											</li>
										))}
									</ul>
								) : (
									<p class="text-sm text-gray-500">Este piso aún no tiene habitaciones.</p>
								)}
							</div>

							<!-- Zonas comunes -->
							<div class="card p-4 sm:p-6">
								<h2 class="mb-1 text-lg font-semibold">
									Zonas comunes ({commonImages.length} fotos · {commonVideos.length} vídeos)
								</h2>
								<p class="mb-4 text-xs text-gray-500">
									Se muestran en todas las habitaciones del piso. Se gestionan desde la edición de cualquiera de ellas.
								</p>
								{commonImages.length > 0 ? (
									<div class="grid grid-cols-3 gap-2 sm:grid-cols-5">
										{commonImages.map((img) => (
											<img src={publicImageUrl(img.path)} alt="" class="h-24 w-full rounded object-cover" loading="lazy" />
										))}
									</div>
								) : (
									<p class="text-sm text-gray-500">Sin fotos de zonas comunes.</p>
								)}
								{commonVideos.length > 0 && (
									<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
										{commonVideos.map((v) => (
											<video src={publicImageUrl(v.path)} controls preload="metadata" class="w-full rounded bg-black" />
										))}
									</div>
								)}
							</div>
						</div>

						<div class="space-y-6">
							<!-- Datos -->
							<div class="card p-4 sm:p-6">
								<h2 class="mb-4 text-lg font-semibold">Datos</h2>
								<dl class="space-y-3 text-sm">
									<div class="flex justify-between gap-4"><dt class="text-gray-500">ID</dt><dd class="min-w-0 break-all text-right font-mono">{flat.flat_id}</dd></div>
									<div class="flex justify-between gap-4"><dt class="text-gray-500">Título</dt><dd class="text-right">{flat.title}</dd></div>
									<div class="flex justify-between gap-4"><dt class="text-gray-500">Dirección</dt><dd class="text-right">{flat.street ?? "—"}</dd></div>
									<div class="flex justify-between gap-4"><dt class="text-gray-500">Barrio</dt><dd class="text-right">{flat.neighborhood ?? "—"}</dd></div>
									<div class="flex justify-between gap-4"><dt class="text-gray-500">Ciudad</dt><dd class="text-right">{flat.postalCode ?? ""} {flat.city ?? "—"}</dd></div>
									<div class="flex justify-between gap-4"><dt class="text-gray-500">Estado</dt><dd>{flat.available ? "Activo" : "Inactivo"}</dd></div>
								</dl>
								{flat.mapImage ? (
									<iframe src={flat.mapImage} title="Mapa del piso" class="mt-4 h-56 w-full rounded" loading="lazy"></iframe>
								) : (
									<p class="mt-4 rounded bg-gray-50 p-3 text-sm text-gray-500">Sin mapa configurado.</p>
								)}
							</div>

							<!-- Consultas -->
							<div class="card p-4 sm:p-6">
								<div class="mb-4 flex items-center justify-between">
									<h2 class="text-lg font-semibold">Últimas consultas</h2>
									<a href="/admin/bookings" class="text-sm text-indigo-600 hover:underline">Ver todas</a>
								</div>
								{leadsRes?.data && leadsRes.data.length > 0 ? (
									<ul class="space-y-3 text-sm">
										{leadsRes.data.map((l) => (
											<li class="space-y-1 border-b border-gray-100 pb-3 last:border-0 last:pb-0">
												<div class="flex items-center justify-between gap-2">
													<span class="font-medium">{l.name}</span>
													<span class={`badge ${LEAD_STATUS[l.status].badge}`}>{LEAD_STATUS[l.status].label}</span>
												</div>
												<p class="text-xs text-gray-500">
													{fmt.format(new Date(l.created_at))} · {l.room_slug}
												</p>
											</li>
										))}
									</ul>
								) : (
									<p class="text-sm text-gray-500">Aún no hay consultas para este piso.</p>
								)}
							</div>
						</div>
					</div>
				</div>
			)
		}
	</SectionContainer>
</LayoutAdmin>

<style>
	.badge {
		@apply px-2 py-1 text-xs rounded-full;
	}
	.card {
		@apply bg-white rounded-lg shadow;
	}
	.btn-primary {
		@apply inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors;
	}
	.btn-secondary {
		@apply inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors;
	}
</style>
