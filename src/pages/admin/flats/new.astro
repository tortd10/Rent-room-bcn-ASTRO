---
import SectionContainer from "@/components/SectionContainer.astro"
import LayoutAdmin from "@/layouts/LayoutAdmin.astro"
import ReadOnlyBadge from "@/components/admin/ReadOnlyBadge.astro"
import FlatForm from "@/components/admin/FlatForm.astro"
import { createFlat } from "@/db/api/flats"
import { parseFlatForm, validateFlat } from "@/lib/flatForm"

const { user, supabase } = Astro.locals
if (!user) return Astro.redirect("/admin")

let errors: Record<string, string> = {}
let flat = {}

if (Astro.request.method === "POST") {
	const newFlat = parseFlatForm(await Astro.request.formData())
	flat = newFlat
	errors = validateFlat(newFlat, { checkId: true })

	if (Object.keys(errors).length === 0) {
		const { error } = await createFlat(supabase, newFlat)
		if (!error) {
			return Astro.redirect(
				`/admin/flats?success=${encodeURIComponent(`Piso ${newFlat.title} creado. Queda pendiente de aprobación`)}`
			)
		}
		// 23505: ya existe un piso con ese ID
		errors =
			error.code === "23505"
				? { flat_id: "Ya existe un piso con ese ID" }
				: { general: error.message || "Error al guardar. Inténtalo de nuevo." }
	}
}
---

<LayoutAdmin title="Nuevo Piso">
	<SectionContainer>
		<div class="space-y-6 p-4 sm:p-6">
			<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
				<h1 class="text-2xl font-bold text-gray-800">Nuevo Piso</h1>
				<div class="flex flex-wrap items-center gap-3">
					<ReadOnlyBadge />
					<a href="/admin/flats" class="inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">Listado de pisos</a>
				</div>
			</div>
			<div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow">
				<FlatForm flat={flat} errors={errors} action="/admin/flats/new" />
			</div>
		</div>
	</SectionContainer>
</LayoutAdmin>
