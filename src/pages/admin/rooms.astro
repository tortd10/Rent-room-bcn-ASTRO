---
import SectionContainer from "@/components/SectionContainer.astro"
import LayoutAdmin from "@/layouts/LayoutAdmin.astro"
import ReadOnlyBadge from "@/components/admin/ReadOnlyBadge.astro"
import PendingBadge from "@/components/admin/PendingBadge.astro"
import ApproveButton from "@/components/admin/ApproveButton.astro"
import { approveRoom, deleteRoom, getAllRooms } from "@/db/api/rooms"

const { user } = Astro.locals
if (!user) {
  return Astro.redirect("/admin")
}

// Eliminar una habitación (el navegador pide confirmación antes de enviar el formulario)
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()

  // Aprobar una habitación pendiente
  if (form.has("approve_id")) {
    const approveId = Number(form.get("approve_id"))
    const approveName = form.get("approve_name")?.toString() ?? ""
    const { error: approveError } = Number.isInteger(approveId)
      ? await approveRoom(Astro.locals.supabase, approveId)
      : { error: "id" }
    return Astro.redirect(
      `/admin/rooms?${
        approveError
          ? "error=" + encodeURIComponent("No se pudo aprobar la habitación")
          : "success=" + encodeURIComponent(`Habitación ${approveName} aprobada y publicada`)
      }`
    )
  }
  const id = Number(form.get("delete_id"))
  const name = form.get("delete_name")?.toString() ?? ""

  let query: string
  if (!Number.isInteger(id)) {
    query = "error=" + encodeURIComponent("Habitación no válida")
  } else {
    const { error: deleteError } = await deleteRoom(Astro.locals.supabase, id)
    query = deleteError
      ? "error=" + encodeURIComponent("No se pudo eliminar la habitación")
      : "success=" + encodeURIComponent(`Habitación ${name} eliminada`)
  }
  return Astro.redirect(`/admin/rooms?${query}`)
}

const success = Astro.url.searchParams.get("success")
const failure = Astro.url.searchParams.get("error")

// Obtener todas las habitaciones con información del piso
const { data: rooms, error } = await getAllRooms(Astro.locals.supabase)
---

<LayoutAdmin title="RentRoomBcn - Habitaciones">
  <SectionContainer>
    <div class="p-4 sm:p-6 space-y-6">
      <!-- Encabezado con botón de acción -->
	  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
		<div>
		  <h1 class="text-2xl font-bold text-gray-800">Gestión de Habitaciones</h1>
		  <p class="text-sm text-gray-500">
			{rooms?.length || 0} habitaciones registradas
		  </p>
		</div>
		<div class="flex flex-wrap items-center gap-2">
		  <ReadOnlyBadge />
		  <a href="/admin/rooms/new" class="btn-primary">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
			  <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
			</svg>
			Nueva Habitación
		  </a>
		</div>
	  </div>

      {success && <p class="rounded-md bg-green-50 p-4 text-sm font-medium text-green-800" role="status">{success}</p>}
      {failure && <p class="rounded-md bg-red-50 p-4 text-sm font-medium text-red-800" role="alert">{failure}</p>}

      <!-- Tabla de habitaciones -->
      <div class="md:bg-white md:shadow md:rounded-lg md:overflow-x-auto md:border md:border-gray-200">
        <table class="block md:table min-w-full divide-y divide-gray-200">
          <thead class="hidden md:table-header-group bg-gray-50">
            <tr>
              <th class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nombre</th>
              <th class="hidden md:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Piso</th>
              <th class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
              <th class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
            </tr>
          </thead>
          <tbody class="block md:table-row-group space-y-3 md:space-y-0 md:bg-white md:divide-y md:divide-gray-200">
            {rooms && rooms.length > 0 ? (
              rooms.map((room) => (
                <tr id={`room-${room.id}`} class="block md:table-row bg-white rounded-lg border border-gray-200 shadow-sm p-4 space-y-3 md:space-y-0 md:p-0 md:rounded-none md:border-0 md:shadow-none hover:bg-gray-50 transition-colors">
                  <td class="block md:table-cell md:px-6 md:py-4 md:whitespace-nowrap">
                    <div class="flex items-center">
                      {room.imageSrc && (
                        <div class="flex-shrink-0 h-10 w-10 mr-3">
                          <img class="h-10 w-10 rounded-full object-cover" src={room.imageSrc} alt={room.imageAlt || room.name} />
                        </div>
                      )}
                      <div>
                        <div class="text-sm font-medium text-gray-900">{room.name}</div>
                        <div class="text-sm text-gray-500">ID: {room.slug}</div>
                        {room.approved === false && (
                          <div class="mt-1 flex flex-wrap items-center gap-2">
                            <PendingBadge approved={room.approved} />
                            <ApproveButton action="/admin/rooms" id={room.id} name={room.name} approved={room.approved} variant="pill" />
                          </div>
                        )}
                        <div class="text-xs text-gray-500 md:hidden">{room.flats?.title || "Sin piso"}</div>
                      </div>
                    </div>
                  </td>
                  <td class="hidden md:table-cell px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 font-medium">{room.flats?.title || 'Sin piso'}</div>
                    {room.flats?.street && (
                      <div class="text-xs text-gray-500">{room.flats.street}</div>
                    )}
                  </td>
				  <td class="block md:table-cell md:px-6 md:py-4 md:whitespace-nowrap">
					<span class={`px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${
						room.available 
						? (room.status === 'soon' ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800')
						: 'bg-red-100 text-red-800'
					}`}>
						{room.available ? 'Disponible' : 'Ocupada'}
					</span>
					{room.status && (
						<span class="ml-2 px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
						{room.status}
						</span>
					)}
				</td>
                  <td class="block md:table-cell md:px-6 md:py-4 md:whitespace-nowrap text-sm text-gray-500 border-t border-gray-100 pt-3 md:border-0 md:pt-4">
                    <div class="flex flex-wrap gap-x-5 gap-y-3">
                      <a 
                        href={`/admin/rooms/edit/${room.id}`} 
                        class="text-indigo-600 hover:text-indigo-900 flex items-center"
                        title="Editar"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                        Editar
                      </a>
                      <a 
                        href={`/admin/rooms/view/${room.slug || room.id}`} 
                        class="text-green-600 hover:text-green-900 flex items-center"
                        title="Ver detalles"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                        Ver
                      </a>
                      <form method="POST" class="delete-room-form" data-name={room.name} data-readonly={Astro.locals.isViewer ? "" : undefined}>
                        <input type="hidden" name="delete_id" value={room.id} />
                        <input type="hidden" name="delete_name" value={room.name} />
                        <button type="submit" class="text-red-600 hover:text-red-900 flex items-center" title="Eliminar">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                          Eliminar
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))
            ) : (
              <tr>
                <td colspan="4" class="block md:table-cell px-6 py-4 text-center text-gray-500">
                  No hay habitaciones registradas
                  {error && (
                    <div class="text-red-500 text-sm mt-2">
                      Error al cargar: {error.message}
                    </div>
                  )}
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </SectionContainer>
</LayoutAdmin>

<script>
  // Confirmación antes de eliminar: la acción es irreversible
  document.querySelectorAll<HTMLFormElement>("form.delete-room-form").forEach((form) => {
    form.addEventListener("submit", (e) => {
      if (form.hasAttribute("data-readonly")) return
      const name = form.dataset.name ?? "esta habitación"
      const ok = confirm(
        `¿Eliminar la habitación "${name}"?

Se borrarán también sus fotos y vídeos. Esta acción no se puede deshacer.`
      )
      if (!ok) e.preventDefault()
    })
  })
</script>

<style is:global>
  .btn-primary {
    @apply inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors;
  }
  .btn-secondary {
    @apply inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors;
  }
</style>