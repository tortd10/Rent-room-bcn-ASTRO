---
import SectionContainer from "@/components/SectionContainer.astro"
import LayoutAdmin from "@/layouts/LayoutAdmin.astro"
import PendingBadge from "@/components/admin/PendingBadge.astro"
import ApproveButton from "@/components/admin/ApproveButton.astro"
import { approveFlat, deleteFlat, getAllFlats } from "@/db/api/flats"

const { user } = Astro.locals
if (!user) {
  return Astro.redirect("/admin")
}

// Eliminar un piso (el navegador pide confirmación antes de enviar el formulario)
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData()

  // Aprobar un piso pendiente
  if (form.has("approve_id")) {
    const approveId = form.get("approve_id")?.toString() ?? ""
    const approveName = form.get("approve_name")?.toString() ?? approveId
    const { error: approveError } = approveId
      ? await approveFlat(Astro.locals.supabase, approveId)
      : { error: "id" }
    return Astro.redirect(
      `/admin/flats?${
        approveError
          ? "error=" + encodeURIComponent("No se pudo aprobar el piso")
          : "success=" + encodeURIComponent(`Piso ${approveName} aprobado y publicado`)
      }`
    )
  }
  const flatId = form.get("delete_id")?.toString() ?? ""
  const name = form.get("delete_name")?.toString() ?? flatId

  const result = flatId ? await deleteFlat(Astro.locals.supabase, flatId) : { error: "id" }
  const message = result.blockedByRooms
    ? `error=${encodeURIComponent(`No se puede eliminar "${name}": tiene ${result.blockedByRooms} habitación(es). Elimínalas o muévelas antes.`)}`
    : result.error
      ? `error=${encodeURIComponent("No se pudo eliminar el piso")}`
      : `success=${encodeURIComponent(`Piso ${name} eliminado`)}`
  return Astro.redirect(`/admin/flats?${message}`)
}

const success = Astro.url.searchParams.get("success")
const failure = Astro.url.searchParams.get("error")

const { data: flats } = await getAllFlats(Astro.locals.supabase)
const { data: roomRows } = await Astro.locals.supabase.from("rooms").select("flat_id, available")
const roomCount = (flatId: string) => (roomRows ?? []).filter((r) => r.flat_id === flatId).length
const availableCount = (flatId: string) =>
  (roomRows ?? []).filter((r) => r.flat_id === flatId && r.available).length
---

<LayoutAdmin title="RentRoomBcn - Pisos">
  <SectionContainer>
    <div class="p-4 sm:p-6 space-y-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h1 class="text-2xl font-bold text-gray-800">Gestión de Pisos</h1>
        
		<div class="flex flex-wrap items-center gap-2">
			<a href="/admin/flats/new" class="btn-primary">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
				  </svg>
				Nuevo Piso
			  </a>
		  </div>
      </div>

      {success && <p class="rounded-md bg-green-50 p-4 text-sm font-medium text-green-800" role="status">{success}</p>}
      {failure && <p class="rounded-md bg-red-50 p-4 text-sm font-medium text-red-800" role="alert">{failure}</p>}

      <div class="md:bg-white md:shadow md:rounded-lg">
        <table class="block md:table min-w-full divide-y divide-gray-200">
          <thead class="hidden md:table-header-group bg-gray-50">
            <tr>
              <th class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Título</th>
              <th class="hidden md:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Dirección</th>
              <th class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Habitaciones</th>
              <th class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Estado</th>
              <th class="px-3 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Acciones</th>
            </tr>
          </thead>
          <tbody class="block md:table-row-group space-y-3 md:space-y-0 md:bg-white md:divide-y md:divide-gray-200">
            {flats?.map((flat) => (
              <tr id={flat.flat_id} class="block md:table-row bg-white rounded-lg border border-gray-200 shadow-sm p-4 space-y-2 md:space-y-0 md:p-0 md:rounded-none md:border-0 md:shadow-none">
                <td class="block md:table-cell md:px-6 md:py-4 text-sm font-medium text-gray-900">{flat.title}<div class="font-mono text-xs font-normal text-gray-500">ID: {flat.flat_id}</div>{flat.approved === false && (
                  <div class="mt-1 flex flex-wrap items-center gap-2 font-sans font-normal">
                    <PendingBadge approved={flat.approved} />
                    <ApproveButton action="/admin/flats" id={flat.flat_id} name={flat.title} approved={flat.approved} variant="pill" />
                  </div>
                )}{flat.street && <div class="text-xs font-normal text-gray-500 md:hidden">{flat.street}</div>}</td>
                <td class="hidden md:table-cell px-6 py-4 text-sm text-gray-500">{flat.street}</td>
                <td class="block md:table-cell md:px-6 md:py-4 text-sm text-gray-500">{availableCount(flat.flat_id)} de {roomCount(flat.flat_id)} disponibles</td>
                <td class="block md:table-cell md:px-6 md:py-4 text-sm">
                  {flat.available ? (
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                      Activo
                    </span>
                  ) : (
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                      Inactivo
                    </span>
                  )}
                </td>
                <td class="flex flex-wrap items-center gap-x-5 gap-y-2 md:table-cell md:px-6 md:py-4 text-sm text-gray-500 border-t border-gray-100 pt-3 md:border-0 md:pt-4">
                  <a href={`/admin/flats/edit/${flat.flat_id}`} class="text-blue-600 hover:text-blue-900 md:mr-3 py-1">Editar</a>
                  <a href={`/admin/flats/view/${flat.flat_id}`} class="text-green-600 hover:text-green-900 md:mr-3 py-1">Ver</a>
                  <form method="POST" class="delete-flat-form inline" data-readonly={Astro.locals.isViewer ? "" : undefined} data-name={flat.title} data-rooms={roomCount(flat.flat_id)}>
                    <input type="hidden" name="delete_id" value={flat.flat_id} />
                    <input type="hidden" name="delete_name" value={flat.title} />
                    <button type="submit" class="text-red-600 hover:text-red-900">Eliminar</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </SectionContainer>
</LayoutAdmin>

<script>
  // Confirmación antes de eliminar: la acción es irreversible
  document.querySelectorAll<HTMLFormElement>("form.delete-flat-form").forEach((form) => {
    form.addEventListener("submit", (e) => {
      if (form.hasAttribute("data-readonly")) return
      const name = form.dataset.name ?? "este piso"
      const rooms = Number(form.dataset.rooms ?? 0)
      if (rooms > 0) {
        alert(`No se puede eliminar "${name}": tiene ${rooms} habitación(es). Elimínalas o muévelas a otro piso antes.`)
        e.preventDefault()
        return
      }
      const ok = confirm(
        `¿Eliminar el piso "${name}"?\n\nSe borrarán también sus fotos y vídeos de zonas comunes. Esta acción no se puede deshacer.`
      )
      if (!ok) e.preventDefault()
    })
  })
</script>

<style is:global>
	.btn-primary {
	  @apply inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors;
	}
	.btn-secondary {
	  @apply inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition-colors;
	}
  </style>