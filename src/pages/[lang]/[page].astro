---
// Única página que resuelve esta ruta: /es/Legal y /en/Legal (con mayúscula, como la enlazan
// el banner de cookies y el footer). El resto de páginas tienen su propio fichero en [lang]/.
// Es estática y no usa datos de Supabase; además, al ser estática no choca con la ruta
// dinámica de [slug].astro (fichas de habitación).
import LegalSite from "@/components/LegalSite.astro"
import i18next from "@/i18n/config.js"
import Layout from "@/layouts/Layout.astro"

export const prerender = true

export function getStaticPaths() {
	return [
		{ params: { lang: "es", page: "Legal" } },
		{ params: { lang: "en", page: "Legal" } },
	]
}

const { lang } = Astro.params
const findRoom = i18next.getResourceBundle(lang as string, "translation").FindRoom
---

<Layout title={`RentRoomBcn - ${findRoom.find_room || "Rooms"}`}>
	<LegalSite />
</Layout>
