---
import PLPRoom from "@/components/PLPRoom.astro"
import i18next from "@/i18n/config.js"
import Layout from "@/layouts/Layout.astro"

const lang = Astro.url.pathname.split("/")[1] || "es"
if (lang !== "es" && lang !== "en") return Astro.redirect("/404")
const translations = i18next.getResourceBundle(lang, "translation")
const findRoom = translations.FindRoom


// Render bajo demanda: los cambios del admin se ven sin redeploy (caché en el CDN de Vercel)
export const prerender = false

Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=86400")
---

<Layout title={`RentRoomBcn - ${findRoom.find_room}`}>
	<PLPRoom />
</Layout>
