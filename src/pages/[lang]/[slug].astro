---
import PDPRoom from "@/components/PDPRoom.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import i18next from "@/i18n/config.js"
import Layout from "@/layouts/Layout.astro"
import { getFlats, getRoomBySlug } from "@/db/public"
import { absoluteUrl } from "@/lib/images"
import { localizeRoom } from "@/lib/localize"

// Render bajo demanda: los cambios hechos en el admin se ven sin redeploy.
export const prerender = false

const { slug, lang: langParam } = Astro.params

if (langParam !== "es" && langParam !== "en") return Astro.redirect("/404")

const [room, flats] = await Promise.all([getRoomBySlug(slug as string), getFlats()])
if (!room) return Astro.redirect("/404")

// Caché en el CDN de Vercel: rápido, y se refresca en segundo plano
Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=86400")

const lang = Astro.url.pathname.split("/")[1] || "es"
const translations = i18next.getResourceBundle(lang, "translation")

const seo = localizeRoom(room, lang)
const flat = flats.find((f) => f.flat_id === room.flat_id)

const schema = {
	"@context": "https://schema.org",
	"@type": "Accommodation",
	"name": room.name,
	"description": seo.metaDescription,
	"image": absoluteUrl(room.imageSrc),
	"url": `https://www.rentroombcn.com/${lang}/${room.slug}`,
	"address": {
		"@type": "PostalAddress",
		"streetAddress": flat?.street ?? "",
		"addressLocality": flat?.city ?? "Barcelona",
		"postalCode": flat?.postalCode ?? "",
		"addressCountry": "ES",
	},
	"accommodationCategory": "Room",
	"petsAllowed": false,
}
---

<Layout title={seo.metaTitle} description={seo.metaDescription}>
	<Fragment slot="head">
		<meta property="og:title" content={seo.metaTitle} />
		<meta property="og:description" content={seo.metaDescription} />
		<meta property="og:image" content={absoluteUrl(room.imageSrc)} />
		<meta property="og:url" content={`https://www.rentroombcn.com/${lang}/${room.slug}`} />
		<meta property="og:type" content="website" />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</Fragment>

	<SectionContainer class="px-0">
		<div class="mx-auto max-w-7xl px-6 lg:px-8">
			<PDPRoom room={room} />
		</div>
	</SectionContainer>
</Layout>
